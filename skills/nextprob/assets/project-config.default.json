{
  "version": 1,
  "metadataFields": {
    "published": {
      "source": "noteKv",
      "key": "__shareId",
      "read": "truthy"
    }
  },
  "collections": {
    "favorites": {
      "source": "items",
      "where": {
        "===": [
          {
            "var": "favorite"
          },
          true
        ]
      },
      "sort": "favoriteOrder"
    },
    "templates": {
      "source": "notes",
      "where": {
        "in": [
          "_templates",
          {
            "var": "ancestorPaths"
          }
        ]
      },
      "sort": "title"
    },
    "published": {
      "source": "notes",
      "where": {
        "var": "metadata.published"
      },
      "sort": "title"
    }
  },
  "surfaces": {
    "sidebar": {
      "hideDotFolders": true,
      "sections": [
        {
          "id": "favorites",
          "title": "Favorites",
          "view": "list",
          "collection": "favorites",
          "hideWhenEmpty": true
        },
        {
          "id": "templates",
          "title": "Templates",
          "view": "list",
          "collection": "templates",
          "hideWhenEmpty": true
        },
        {
          "id": "published",
          "title": "Published",
          "view": "list",
          "collection": "published",
          "hideWhenEmpty": true
        },
        {
          "id": "files",
          "title": "Probs",
          "view": "tree",
          "source": "items",
          "hiddenFolders": [
            "_templates"
          ]
        }
      ]
    }
  }
}
